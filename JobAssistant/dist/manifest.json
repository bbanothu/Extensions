{
  "manifest_version": 3,
  "name": "Resume Assistant",
  "version": "2.0.0",
  "description": "Saves and pastes messages on command, finds companies/people on LinkedIn, and tailors your resume to a job posting.",
  "action": {
    "default_icon": "public/assets/copy.png",
    "default_popup": "src/popup/index.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "icons": {
    "16": "public/assets/copy.png",
    "48": "public/assets/copy.png",
    "128": "public/assets/copy.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  }
}
